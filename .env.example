DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webhooks
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-me-in-production
# Maximum ACTIVE endpoints per tenant (default 10); POST /endpoints returns 409 beyond this
MAX_ACTIVE_ENDPOINTS_PER_TENANT=10
# Maximum event payload size in bytes of serialised JSON (default 65536 = 64 KB); POST /events returns 413 beyond this
MAX_EVENT_PAYLOAD_BYTES=65536
